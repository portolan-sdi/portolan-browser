{
  "name": "portolan-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A web viewer for Portolan catalogs, forked from STAC Browser.",
  "main": "src/main.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:preview": "vite build && vite preview",
    "build:report": "vite build --mode report",
    "build:minimal": "vite build --mode minimal",
    "preview": "vite preview",
    "lint": "eslint --fix src",
    "i18n:fields": "node helpers/fields_locales.js",
    "docs:hooks": "node helpers/widget-hooks.js",
    "docs:lint": "remark --frail --silently-ignore *.md docs/*.md",
    "test:docker": "bash tests/docker/run-tests.sh",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "bash tests/integration/run-tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "bugs": {
    "url": "https://github.com/portolan-sdi/portolan-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portolan-sdi/portolan-browser.git"
  },
  "author": "Portolan SDI",
  "contributors": [
    {
      "name": "Matthias Mohr"
    },
    {
      "name": "Rob Emanuele"
    },
    {
      "name": "Seth Fitzsimmons"
    },
    {
      "name": "moreGeo GmbH",
      "url": "https://moregeo.it"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.2.2",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/view": "^6.43.5",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@developmentseed/deck.gl-geotiff": "^0.7.0",
    "@developmentseed/geotiff": "^0.7.0",
    "@musement/iso-duration": "^1.0.0",
    "@radiantearth/stac-fields": "~1.5.9",
    "@radiantearth/stac-migrate": "~2.0.2",
    "@turf/mask": "^7.2.0",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.2.1",
    "ajv-i18n": "^4.2.0",
    "axios": "^1.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.42.0",
    "chart.js": "^4.3.0",
    "commonmark": "^0.31.2",
    "content-type": "^2.0.0",
    "date-fns": "^4.4.0",
    "hyparquet": "^1.25.6",
    "hyparquet-compressors": "^1.1.1",
    "json-source-map": "^0.6.1",
    "maplibre-gl": "^5.1.0",
    "oidc-client-ts": "^3.0.1",
    "pmtiles": "^4.0.0",
    "proj4": "^2.16.1",
    "remove-markdown": "^0.6.2",
    "shiki": "^3.22.0",
    "stac-js": "^0.5.3",
    "stac-node-validator": "2.0.0-rc.3",
    "streamsaver-js": "^2.0.7",
    "urijs": "^1.19.11",
    "vue": "^3.5.22",
    "vue-chartjs": "^5.2.0",
    "vue-codemirror6": "^1.6.1",
    "vue-i18n": "^11.2.0",
    "vue-multiselect": "^3.3.1",
    "vue-router": "^5.0.1",
    "vuex": "^4.1.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@iconify-json/bi": "^1.2.6",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.2.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "msw": "^2.12.10",
    "playwright-msw": "^3.0.1",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-literal-urls": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-validate-links": "^13.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.26.5",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.6",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.8"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "remarkConfig": {
    "plugins": [
      "remark-gfm",
      "validate-links",
      "remark-preset-lint-consistent",
      "remark-preset-lint-recommended",
      [
        "remark-lint-no-undefined-references",
        {
          "allow": [
            "!WARNING",
            "!NOTE",
            "!IMPORTANT",
            "!CAUTION",
            "!TIP"
          ]
        }
      ],
      "remark-lint-no-literal-urls",
      [
        "remark-lint-no-shortcut-reference-link",
        false
      ]
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix"
    ],
    "*.md": [
      "remark --frail"
    ]
  }
}
